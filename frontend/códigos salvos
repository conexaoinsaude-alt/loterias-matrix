*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Segoe UI,Arial,sans-serif;
}

body{
    background:#0f172a;
    color:#ffffff;
}

.app{
    display:flex;
    min-height:100vh;
}

.sidebar{
    width:260px;
    background:#111827;
    padding:30px 20px;
    border-right:1px solid #1f2937;
}

.logo{
    text-align:center;
    margin-bottom:40px;
}

.logo h1{
    font-size:26px;
    color:#38bdf8;
}

.logo span{
    color:#94a3b8;
    font-size:14px;
}

.sidebar ul{
    list-style:none;
}

.sidebar li{
    padding:14px;
    margin-bottom:8px;
    border-radius:10px;
    cursor:pointer;
    transition:.3s;
}

.sidebar li:hover{
    background:#1e293b;
}

.sidebar .active{
    background:#2563eb;
}

.content{
    flex:1;
    padding:35px;
}

header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:35px;
}

header h2{
    color:#38bdf8;
}

#api-status{
    background:#1e293b;
    padding:10px 18px;
    border-radius:8px;
}

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
    margin-bottom:40px;
}

.card{
    background:#1e293b;
    padding:25px;
    border-radius:12px;
    border:1px solid #334155;
}

.card h3{
    margin-bottom:15px;
    color:#38bdf8;
}

.card p{
    font-size:18px;
}

.welcome{
    background:#1e293b;
    padding:30px;
    border-radius:12px;
    border:1px solid #334155;
}

.welcome h2{
    color:#38bdf8;
    margin-bottom:20px;
}

.welcome p{
    line-height:1.8;
}